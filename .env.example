# Copy to .env and fill in real values. .env is gitignored.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tpjewellers

# Any OpenAI-compatible chat-completions provider works here — currently
# OpenRouter (openrouter.ai) hosting gpt-4o-mini. No local model/GPU needed.
# (Tried NVIDIA NIM first; its endpoint stalled for minutes on this network
# for reasons unrelated to NIM itself. Then DeepSeek — worked, but
# confabulated a payment success without calling the tool on some repeated
# requests. gpt-4o-mini reliably calls a tool on every state-changing
# request in the same tests — see JOURNAL.md for the full comparison.)
# Accepts ONE key, or several comma-separated for failover — the
# orchestrator tries the active key first and rotates to the next on auth,
# exhausted-credit (402), rate-limit (429), or provider-outage errors. It
# deliberately does NOT rotate on 400-class errors: those mean our request is
# malformed, and burning through every key would just hide the real message.
# LLM_API_KEYS is accepted as an alias and takes priority if both are set.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Embeddings for the knowledge-base hybrid search (src/knowledge). Only needed
# once index_knowledge.py is run.
VOYAGE_API_KEY=

# Real auth (SuperTokens, self-hosted) — see JOURNAL.md / docs/ARCHITECTURE.md.
# SuperTokens core must be running (docker compose up -d) and pointed at its
# own "supertokens" database — see scripts/init-supertokens-db.sql.
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
API_DOMAIN=http://localhost:8000
WEBSITE_DOMAIN=http://localhost:3000

# Email transport for OTP-over-email login. Gmail SMTP + a Google App
# Password (NOT your real Gmail password — requires 2-Step Verification
# enabled, generate one at myaccount.google.com/apppasswords). From must
# match the authenticated account or Gmail's relay rejects it.
# LOCAL DEV ONLY — see RESEND_* below for why this can't be used in prod.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# PRODUCTION email transport — Resend's HTTP API (api.resend.com), used
# instead of SMTP because Railway blocks outbound SMTP (25/465/587) at the
# network level (confirmed live, see JOURNAL.md). If both RESEND_* and
# SMTP_* are set, Resend wins (src/api/auth.py::_build_email_service).
# Free tier without a verified custom domain can only send FROM
# onboarding@resend.dev TO the email address you signed up to Resend with.
RESEND_API_KEY=
RESEND_FROM=TP Jewellers <onboarding@resend.dev>
